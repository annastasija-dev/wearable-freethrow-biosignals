<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.FTProtocol.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:shadowColor">#66000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">3</item>
    </style>

    <style name="Widget.FTProtocol.HitButton" parent="Widget.Material3.Button">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="backgroundTint">@color/hit_green</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.FTProtocol.MissButton" parent="Widget.Material3.Button">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="backgroundTint">@color/miss_red</item>
        <item name="cornerRadius">16dp</item>
    </style>
</resources>
