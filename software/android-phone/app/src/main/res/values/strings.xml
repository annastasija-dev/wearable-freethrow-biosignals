    <string name="flow_help_title">Session steps</string>
    <string name="flow_step_1">1. First time: ⋮ → Install on watch. Then open FT Watch.</string>
    <string name="flow_step_2">2. Enter participant code, weight, height, age, sex, and throwing technique.</string>
    <string name="flow_step_3">3. Tap Test cloud connection, then Start session.</string>
    <string name="flow_step_4">4. After each free throw, tap Hit or Miss.</string>
    <string name="flow_step_5">5. After 10 shots, tap Finish session.</string>
