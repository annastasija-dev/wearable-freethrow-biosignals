<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BasketballProtocol" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryContainer">@color/primary_soft</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:popupBackground">@drawable/popup_dropdown_bg</item>
        <item name="popupMenuBackground">@drawable/popup_dropdown_bg</item>
        <item name="actionOverflowButtonStyle">@style/Widget.FTProtocol.Overflow</item>
    </style>

    <style name="ThemeOverlay.FTProtocol.Toolbar" parent="ThemeOverlay.Material3.Dark">
        <item name="colorControlNormal">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="actionMenuTextColor">@android:color/white</item>
    </style>

    <style name="Widget.FTProtocol.Overflow" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:src">@drawable/ic_more_vert_white</item>
        <item name="srcCompat">@drawable/ic_more_vert_white</item>
        <item name="android:tint">@android:color/white</item>
    </style>
</resources>
